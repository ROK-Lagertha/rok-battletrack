{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rok-battletrack",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/leadership", "/leadership/*", "/leadership.html"]
  },
  "observability": {
    "enabled": true
  }
}
